# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# --- Virtual environments (never commit these — see setup_env.ps1 / setup_env.sh) ---
.venv/
venv/
env/
ENV/

# --- Testing / quality tools ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Packaging output (PyInstaller / Inno Setup artifacts) ---
packaging/build/
packaging/dist/
*.exe
*.msi

# --- Compiled Qt translations (regenerate from i18n/*.ts via pyside6-lrelease) ---
i18n/*.qm

# --- Large ML model binaries (track via release assets / Git LFS, not plain git) ---
models/*.onnx
!models/.gitkeep

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
